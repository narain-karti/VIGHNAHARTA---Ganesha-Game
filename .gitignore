# Production scoreboard database (auto-created at runtime by excel_db.py).
# NOTE: vighnaharta_scores.xlsx is currently tracked with seed data.
# To stop recording live scores as git modifications, run:
#   git rm --cached vighnaharta_scores.xlsx
# then commit the removal (file stays on disk, future scores stay untracked).
vighnaharta_scores.xlsx
